# Google OAuth Client ID (di-bundle ke frontend saat build)
# Sama dengan GOOGLE_CLIENT_ID di server/.env
# Buat di https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=

# Alamat API (default: "/api" = same-origin, cocok saat frontend + API
# disajikan dari satu origin, mis. deploy Render server/Dockerfile).
# Set ke URL API yang sudah di-deploy bila frontend dihosting terpisah:
#   VITE_API_URL=https://singgah-api.onrender.com/api
VITE_API_URL=
