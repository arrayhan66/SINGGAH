# ============================================================
# KREDENSIAL & PENGATURAN UNTUK TES E2E (Playwright)
# Salin file ini menjadi .env.test lalu isi nilai yang sesuai.
# JANGAN commit nilai kredensial asli ke repository.
# ============================================================

# URL frontend (biasanya sudah otomatis dari playwright.config.js)
PLAYWRIGHT_BASE_URL=http://localhost:5173

# --- AKUN ADMIN (role: admin) ---
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=changeme
TEST_ADMIN_NAME=Admin Utama

# --- AKUN USER (mahasiswa/dosen, bisa upload) ---
TEST_USER_EMAIL=mahasiswa@example.com
TEST_USER_PASSWORD=changeme
TEST_USER_NAME=Mahasiswa Uji

# --- AKUN DOSEN ---
TEST_DOSEN_EMAIL=dosen@example.com
TEST_DOSEN_PASSWORD=changeme
TEST_DOSEN_NAME=Dosen Uji

# --- AKUN TIPE UMUM (tidak bisa upload) ---
TEST_PUBLIC_EMAIL=umum@example.com
TEST_PUBLIC_PASSWORD=changeme
TEST_PUBLIC_NAME=Umum Uji

# --- PLACEHOLDER SLUG UNTUK TES DETAIL (isi slug karya/berita yang ada di data kamu) ---
TEST_KARYA_SLUG=kategori-slug
TEST_PROJECT_SLUG=nama-project
TEST_BERITA_SLUG=slug-berita

# --- CATEGORY SLUG untuk tes Hall ---
TEST_HALL_CATEGORY=website
