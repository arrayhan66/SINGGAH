AddType text/markdown .md

<IfModule mod_headers.c>
  Header always set Link '<https://singgah.site/llms.txt>; rel="alternate"; type="text/markdown", <https://singgah.site/index.md>; rel="alternate"; type="text/markdown"; title="Versi Markdown"'
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{HTTP_ACCEPT} text/markdown
  RewriteRule ^$ /index.md [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^$ /index.html [L]
  RewriteRule ^(karya|berita|hall|about|contact|terms)(/.*)?$ /index.html [L]
  RewriteRule ^(login|register|forgot-password|verify-code|reset-password|upload|my-karya|profile|karya-tersimpan|edit-karya)(/.*)?$ /index.html [L]
  RewriteRule ^admin(/.*)?$ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "server-card\.json$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET"
    Header set Access-Control-Allow-Headers "Content-Type"
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
