.bl {
  margin-top: -32px;
  padding: 0 0 96px;
}
@media (max-width: 767px) {
  .bl {
    margin-top: -20px;
  }
}
.bl-wrap {
  width: 100%;
  max-width: 1700px;
  margin-right: auto;
  margin-left: auto;
}
.bl-header {
  display: grid;
  grid-template-columns: max-content minmax(min-content, 1fr);
  align-items: end;
  align-items: last baseline;
  justify-content: start;
  column-gap: 64px;
  row-gap: 12px;
  margin-bottom: 40px;
}
@media (max-width: 1023px) {
  .bl-header {
    grid-template-columns: 1fr;
    justify-content: stretch;
  }
}
.bl-heading {
  min-width: 0;
}
.bl-title {
  margin: 0;
  max-width: 900px;
  font-family: var(--font-headline);
  font-size: clamp(36px, 4.4vw, 56px);
  font-weight: 500;
  line-height: 1.02;
  letter-spacing: -0.02em;
  color: #0f172a;
  white-space: nowrap;
}
@media (max-width: 767px) {
  .bl-title {
    white-space: normal;
    max-width: 620px;
  }
}
.bl-title-line {
  display: block;
  color: #0f172a;
}
.bl-title-accent {
  color: var(--color-accent-primary);
}
.bl-desc {
  margin: 0;
  width: fit-content;
  max-width: 100%;
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--color-slate-500);
  justify-self: end;
  text-align: left;
}
@media (max-width: 1023px) {
  .bl-desc {
    justify-self: start;
    max-width: 560px;
  }
}
.bl-btn {
  height: 48px;
  padding: 0 24px;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.01em;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--color-slate-900, #0f172a);
  background: transparent;
  border: 1px solid transparent;
  box-shadow: none;
  text-decoration: none;
  transition: background-color 300ms ease, border-color 300ms ease, color 300ms ease, box-shadow 300ms ease;
}
.bl-btn--primary {
  background: var(--color-accent-primary);
  color: #ffffff;
  border: none;
  box-shadow: 0 4px 12px -4px rgba(37, 99, 235, 0.45);
  cursor: pointer;
  transition: background-color .2s ease, border-color .2s ease, color .2s ease;
}
.bl-btn--primary:hover {
  background: color-mix(in srgb, var(--color-accent-primary) 88%, black);
  border-color: color-mix(in srgb, var(--color-accent-primary) 88%, black);
}
.bl-btn.bl-btn--primary:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}
.bl-btn--primary:active {
  transform: translateY(1px);
}
.bl-btn--ghost {
  background: transparent;
  border: 1px solid var(--color-slate-300, #cbd5e1);
  color: var(--color-slate-900, #0f172a);
}
.bl-btn--ghost:hover,
.bl-btn--ghost:focus-visible {
  background: var(--color-slate-200, #e2e8f0);
  border-color: var(--color-slate-400, #94a3b8);
  color: var(--color-slate-900, #0f172a);
}
.bl-btn:focus-visible {
  outline: 2px solid var(--color-slate-900, #0f172a);
  outline-offset: 3px;
}

/* ===== tata letak dua kolom: teks kiri, buku kanan ===== */
.bl-layout {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
  gap: 48px;
  align-items: center;
}
.bl-layout .bl-header {
  display: block;
  min-width: 0;
}
.bl-layout .bl-heading {
  margin: 0;
  max-width: none;
}
.bl-layout .bl-desc {
  display: block;
  margin: 20px 0 0;
  max-width: 42ch;
  width: auto;
  text-align: left;
  white-space: normal;
  font-size: 18px;
  line-height: 1.65;
}
.bl-layout .bk {
  min-width: 0;
}

@media (max-width: 900px) {
  .bl-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }
  .bl-layout .bl-desc {
    font-size: 16px;
    max-width: none;
  }
}

/* kolom kiri rata atas, deskripsi sejajar judul */
.bl-layout {
  align-items: start;
}
.bl-layout .bl-header {
  align-self: start;
}
.bl-layout .bl-desc {
  margin: 20px 0 0 0 !important;
  padding: 0 !important;
  text-indent: 0;
  justify-self: start;
  align-self: start;
}

/* panel menu Buletin: teks kiri, dua foto miring kanan */
.bl-promo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  box-sizing: border-box;
  margin-top: 32px;
  width: 0;
  min-width: 100%;
  max-width: none;
  padding: 28px 28px 28px 32px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 24px;
  text-decoration: none;
  color: inherit;
  transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
}
.bl-promo-text {
  min-width: 0;
  flex: 1;
}
.bl-promo-eyebrow {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #64748b;
}
.bl-promo-title {
  display: block;
  margin-top: 8px;
  font-size: 24px;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: #0f172a;
}
.bl-promo-desc {
  margin: 10px 0 0;
  font-size: 14px;
  line-height: 1.6;
  color: #475569;
}
.bl-promo-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 18px;
  height: 44px;
  padding: 0 20px;
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
  background: #111c33;
  border-radius: 999px;
  white-space: nowrap;
  transition: background 0.3s ease;
}
.bl-promo-btn svg {
  transition: transform 0.3s ease;
}
.bl-promo-photos {
  position: relative;
  flex: none;
  width: 210px;
  height: 170px;
}
.bl-promo-photo {
  position: absolute;
  width: 150px;
  height: 112px;
  overflow: hidden;
  border: 3px solid #ffffff;
  border-radius: 14px;
  background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 55%, #e0e7ff 100%);
  box-shadow: 0 14px 28px -12px rgba(15, 23, 42, 0.35);
  transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.bl-promo-photo img,
.bl-promo-ph {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}
.bl-promo:hover {
  transform: translateY(-4px);
  border-color: #bfdbfe;
  box-shadow: 0 22px 40px -20px rgba(37, 99, 235, 0.4);
}
.bl-promo:hover .bl-promo-btn {
  background: #2563eb;
}
.bl-promo:hover .bl-promo-btn svg {
  transform: translateX(4px);
}
.bl-promo:hover .bl-promo-photo-back {
  transform: rotate(9deg) translate(8px, -6px);
}
.bl-promo:hover .bl-promo-photo-front {
  transform: rotate(-8deg) translate(-6px, 4px);
}
.bl-promo:focus-visible {
  outline: 2px solid #2563eb;
  outline-offset: 3px;
}
@media (prefers-reduced-motion: reduce) {
  .bl-promo,
  .bl-promo-btn,
  .bl-promo-btn svg,
  .bl-promo-photo {
    transition: none;
  }
  .bl-promo:hover,
  .bl-promo:hover .bl-promo-btn svg {
    transform: none;
  }
  .bl-promo:hover .bl-promo-photo-back {
    transform: rotate(6deg);
  }
  .bl-promo:hover .bl-promo-photo-front {
    transform: rotate(-5deg);
  }
}
@media (max-width: 900px) {
  .bl-promo {
    width: auto;
    min-width: 0;
  }
}
@media (max-width: 520px) {
