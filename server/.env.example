# Contoh env untuk produksi. SALIN ke .env lalu isi nilainya.
# JANGAN commit .env yang sudah terisi.
#   cp .env.example .env

NODE_ENV=production
PORT=5000

# Jumlah proxy tepercaya di depan Node. WAJIB benar karena rate limiter dan
# log akses membaca IP dari sini.
#   1 = nginx -> Node langsung (uji lokal)
#   2 = browser -> Vercel -> nginx -> Node   <-- NILAI PRODUKSI
# Kalau kurang, semua user terlihat sebagai IP Vercel dan bisa ikut ter-throttle.
TRUST_PROXY=2

# Harus sama dengan instances di ecosystem.config.js, karena rate limiter
# membaca angka ini untuk memperingatkan batas jadi longgar N kali bila
# Redis tidak aktif.
PM2_INSTANCES=3

# Backlog listen. 8192 sudah diuji aman untuk 1000 koneksi serentak.
SERVER_BACKLOG=8192

# Cache & rate limit bersama antar worker PM2.
REDIS_URL=redis://127.0.0.1:6379

# Domain frontend, pisahkan dengan koma. Dipakai untuk whitelist CORS.
FRONTEND_URL=https://frontend-anda.vercel.app

# --- ISI SENDIRI, jangan disalin dari repo ---
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_DIALECT=mysql

SESSION_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
