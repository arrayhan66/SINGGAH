# Contoh env untuk produksi. SALIN ke .env lalu isi nilainya.
# JANGAN commit .env yang sudah terisi.
#   cp .env.example .env
#
# PENTING: nama variabel di sini HARUS sama persis dengan yang dibaca kode.
# Contoh: token login memakai JWT_SECRET, bukan SESSION_SECRET. Salah nama =
# login gagal total tanpa pesan yang jelas.

# --- Wajib ---
NODE_ENV=production

# Di Railway/Vercel JANGAN diisi, platform yang menentukan portnya.
# Di VPS boleh diisi, defaultnya 5000.
PORT=5000

# Secret untuk menandatangani token login (WAJIB, minimal 32 karakter).
# Buat acak: openssl rand -hex 32
JWT_SECRET=

# --- Database (TiDB Cloud) ---
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=

# SSL. Kalau dihapus, aktif secara default (TiDB Cloud mewajibkannya).
# Set "false" HANYA kalau kamu pindah ke MySQL lokal tanpa SSL.
# DB_SSL=true

# Jumlah koneksi database. Railway free hanya 1 GB RAM, jadi 20 sudah lebih
# dari cukup untuk ratusan pengguna. Jangan dinaikkan tanpa alasan.
DB_POOL_MAX=20
DB_POOL_MIN=2

# --- Cloudinary (penyimpanan gambar & berkas berita) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (kalau fitur verifikasi email dipakai) ---
EMAIL_USER=
EMAIL_PASSWORD=

# --- CORS: domain frontend, pisahkan dengan koma ---
# Diisi SETELAH Vercel jadi, lalu redeploy.
FRONTEND_URL=https://frontend-anda.vercel.app

# --- Jumlah proxy tepercaya di depan Node. WAJIB benar karena rate limiter
# dan log akses membaca IP dari sini. Salah => semua user terlihat satu IP.
#   0 = tidak ada proxy (localhost)
#   1 = Railway / Render / Vercel Functions  -> NILAI UNTUK RAILWAY
#   2 = browser -> Vercel -> nginx -> Node   -> NILAI UNTUK VPS
TRUST_PROXY=1

# --- Opsional ---
# Cache bersama antar worker. Kalau kosong, pakai cache di RAM per proses
# (cukup untuk Railway 1 worker). Butuh ini hanya kalau nanti PM2 > 1 worker.
# REDIS_URL=redis://127.0.0.1:6379

# Backlog listen. 8192 sudah diuji aman untuk 1000 koneksi serentak.
SERVER_BACKLOG=8192

# Jumlah worker PM2 (hanya relevan di VPS, abaikan di Railway).
PM2_INSTANCES=3

# Naikkan untuk melihat log lebih detail saat debugging.
# LOG_LEVEL=debug
