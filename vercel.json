{
  "version": 2,
  "framework": null,
  "buildCommand": "cd client && npm install && npm run build",
  "builds": [
    {
      "src": "server/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "client/dist/**",
          "server/scripts/**",
          "server/docs/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server/api/index.js"
    }
  ]
}